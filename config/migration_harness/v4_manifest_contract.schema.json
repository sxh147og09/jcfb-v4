{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v4-migration-manifest-contract@1.0.0",
  "title": "JCFB V4 parsed migration manifest contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_manifest",
    "source_sql_directory",
    "schema_contract_version",
    "parse_mode",
    "authoritative",
    "entries",
    "dependency_graph"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "contract_version": {
      "const": "v4-migration-manifest-contract@1.0.0"
    },
    "source_manifest": {
      "const": "database/migrations/v4/0000_manifest.md"
    },
    "source_sql_directory": {
      "const": "database/migrations/v4"
    },
    "schema_contract_version": {
      "const": "v4-database-schema@1.0.0"
    },
    "parse_mode": {
      "const": "TEXT_METADATA_ONLY"
    },
    "authoritative": {
      "const": false
    },
    "entries": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "dependency_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordered_sequences",
        "acyclic_required",
        "parallel_execution_allowed",
        "missing_parent_action"
      ],
      "properties": {
        "ordered_sequences": {
          "type": "array",
          "const": [
            "0001",
            "0002",
            "0003",
            "0004",
            "0005",
            "0006",
            "0007",
            "0008",
            "0009"
          ]
        },
        "acyclic_required": {
          "const": true
        },
        "parallel_execution_allowed": {
          "const": false
        },
        "missing_parent_action": {
          "const": "BLOCK"
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "file",
        "migration_id",
        "migration_version",
        "schema_contract_version",
        "authored_at",
        "name",
        "depends_on",
        "expected_objects",
        "migration_hash",
        "status"
      ],
      "properties": {
        "sequence": {
          "type": "string",
          "pattern": "^000[1-9]$"
        },
        "file": {
          "type": "string",
          "pattern": "^database/migrations/v4/000[1-9]_.+\\.sql$"
        },
        "migration_id": {
          "type": "string",
          "pattern": "^migration@20260901\\.00[1-9]$"
        },
        "migration_version": {
          "type": "string",
          "pattern": "^migration@20260901\\.00[1-9]$"
        },
        "schema_contract_version": {
          "const": "v4-database-schema@1.0.0"
        },
        "authored_at": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "pattern": "^v4-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^migration@20260901\\.00[1-9]$"
          }
        },
        "expected_objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "migration_hash": {
          "const": "PENDING_CANONICAL_HASH"
        },
        "status": {
          "const": "DRAFT"
        }
      }
    }
  }
}
