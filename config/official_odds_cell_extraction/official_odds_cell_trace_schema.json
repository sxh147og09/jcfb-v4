{
  "$id": "official-odds-cell-trace@1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JCFB V4 Official Odds Cell Extraction Trace",
  "type": "object",
  "required": ["trace_record_id", "artifact_identity", "raw_image_sha256", "layout_profile_identity", "market", "source_visible_label", "canonical_outcome_label", "ordering_index", "deterministic_locator", "region_coordinates", "cell_coordinates", "implementation_identity", "implementation_version", "implementation_hash", "parser_config_identity", "parser_config_hash", "ocr_evidence", "parsed_value", "parser_status", "parser_reason", "contradiction_state", "market_availability_status", "source_timestamps", "trace_record_sha256"],
  "properties": {
    "trace_record_id": {"type": "string", "minLength": 1},
    "artifact_identity": {"type": "string", "minLength": 1},
    "raw_image_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "layout_profile_identity": {"type": "string", "minLength": 1},
    "market": {"enum": ["SPF", "RQSPF", "TOTAL_GOALS", "EXACT_SCORE", "HTFT"]},
    "source_visible_label": {"type": "string", "minLength": 1},
    "canonical_outcome_label": {"type": "string", "minLength": 1},
    "ordering_index": {"type": "integer", "minimum": 0},
    "deterministic_locator": {"type": "object"},
    "region_coordinates": {"type": ["object", "null"]},
    "cell_coordinates": {"type": ["object", "null"]},
    "implementation_identity": {"type": "string", "minLength": 1},
    "implementation_version": {"type": "string", "minLength": 1},
    "implementation_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parser_config_identity": {"type": "string", "minLength": 1},
    "parser_config_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ocr_evidence": {"type": ["object", "null"]},
    "parsed_value": {"type": ["number", "null"]},
    "parser_status": {"enum": ["PARSED", "UNRESOLVED", "AMBIGUOUS", "NOT_PRESENT", "MARKET_UNAVAILABLE", "CONFLICT", "UNSUPPORTED_LAYOUT"]},
    "parser_reason": {"type": "string", "minLength": 1},
    "contradiction_state": {"enum": ["NONE", "CONFLICTED", "NOT_APPLICABLE"]},
    "market_availability_status": {"enum": ["AVAILABLE", "UNAVAILABLE", "UNKNOWN", "BLOCKED"]},
    "source_timestamps": {"type": "object"},
    "trace_record_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
