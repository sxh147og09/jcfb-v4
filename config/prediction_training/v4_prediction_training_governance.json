  "label_contract": {
    "version": "prediction-training-labels@1.0.0",
    "feature_label_separation": "LABELS_ARE_POST_MATCH_TARGETS_ONLY_AND_MUST_NOT_BE_IN_FEATURE_PAYLOAD",
    "targets": {
      "OUTCOME": {
        "classes": ["H", "D", "A"],
        "source": "official_final_match_result",
        "derivation": "home_score versus away_score"
      },
      "HANDICAP": {
        "classes": ["H", "D", "A"],
        "required_refs": ["official_rqspf_handicap_ref", "exact_handicap_value_at_prediction_cutoff"],
        "sign_convention": "home_minus_away",
        "derivation": "home_score + exact_official_handicap versus away_score",
        "replacement_policy": "A post-cutoff or different-time handicap may not replace the cutoff-bound value"
      },
      "GOALS": {
        "classes": ["0", "1", "2", "3", "4", "5", "6", "7+"],
        "source": "official_final_match_result",
        "derivation": "final_home_score + final_away_score with 7+ tail"
      },
      "HTFT": {
        "classes": ["H/H", "H/D", "H/A", "D/H", "D/D", "D/A", "A/H", "A/D", "A/A"],
        "source": "official_halftime_and_fulltime_result",
        "derivation": "official_half_time_state plus official_full_time_state"
      }
    }
  },
  "leakage_prevention_contract": {
    "version": "prediction-training-leakage@1.0.0",
    "hard_predicate": "feature_availability_at <= sample_prediction_cutoff_at < kickoff_at",
    "forbidden_feature_inputs": [
      "final_score",
      "halftime_result",
      "cutoff_after_red_card",
      "cutoff_after_confirmed_starting_lineup",
