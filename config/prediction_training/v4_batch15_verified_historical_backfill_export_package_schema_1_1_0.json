    "package_sha256_excludes": ["package_sha256"],
    "package_zip_sha256_payload": "final_zip_bytes_only",
    "volatile_export_timestamp_not_in_substantive_hash": true,
    "exclusion_manifest_participates_in_package_substantive_hash": true
  },
  "zip_serialization_profile": {
    "profile_id": "v4-deterministic-zip@1.0",
    "format": "PKZIP_ZIP32",
    "version_needed": 20,
    "version_made_by": 20,
    "entry_order": "normalized_utf8_path_ascending",
    "path_normalization": "POSIX_relative_NFC_no_dot_segments_no_duplicate_separators",
    "filename_encoding": "UTF-8_with_EFS_flag",
    "directory_entries": "FORBIDDEN",
    "compression": "STORED",
    "compression_level": null,
    "dos_timestamp": "1980-01-01T00:00:00",
    "external_attributes": 32,
    "internal_attributes": 0,
    "platform_metadata": "MSDOS_version_20_no_unix_mode_or_executable_bits_DOS_archive_bit_only",
    "extra_fields": "EMPTY",
    "entry_comments": "EMPTY",
    "archive_comment": "EMPTY",
    "crc": "CRC32_of_uncompressed_bytes_in_local_and_central_headers",
    "data_descriptor": "FORBIDDEN",
    "zip64": "FORBIDDEN",
    "manifest_text_encoding": "UTF-8",
    "manifest_text_newline": "LF_single_trailing_newline",
    "rebuild_requirement": "same_substantive_package_inputs_produce_identical_zip_bytes_and_hash"
  },
  "exclusion_manifest": {
    "required": true,
    "schema_identity": "verified-historical-backfill-exclusion-manifest@1.0.0",
    "record_order": "category_source_reference_filename_source_sha256_exclusion_id_utf8_ascending",
    "required_record_fields": [
      "exclusion_id",
      "category",
      "reason_code",
      "source_filename",
      "source_reference",
      "source_sha256",
      "artifact_classification",
      "record_sha256"
    ],
    "categories_and_reasons": {
      "BETTING_SLIP": "BETTING_SLIP_NOT_RAW_FACT",
      "GENERATED_PREDICTION_DASHBOARD": "GENERATED_PREDICTION_NOT_RAW_FACT",
      "RECOMMENDATION_ARTIFACT": "RECOMMENDATION_NOT_RAW_FACT"
    },
    "artifact_classification": "EXCLUDED",
    "accepted_raw_set_policy": "excluded_source_identity_must_not_occur_in_file_manifest_or_import_manifests",
    "record_hash_payload": "record_without_record_sha256_under_v4-canonical-json@1.0",
    "manifest_hash_payload": "schema_version_and_records_without_manifest_sha256_under_v4-canonical-json@1.0",
    "participates_in_package_substantive_hash": true
  },
  "hash_authority": {
    "package_substantive_hash": "authoritative_semantic_identity",
    "package_sha256": "legacy_package_object_canonical_json_hash_not_zip_hash",
    "package_zip_sha256": "authoritative_transport_integrity_hash_of_final_zip_bytes"
  },
  "write_policy": "MUST_NOT_WRITE_FINAL_ARCHIVE",
  "staging_root": "F:\\Projects\\jcfb-v4\\approved_data\\historical_backfill_staging\\",
