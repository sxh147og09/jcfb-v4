{
  "$id": "verified-historical-backfill-export-package@1.1.0",
  "title": "JCFB V4 Verified Historical Backfill Export Package (additive deterministic transport revision)",
  "status": "FROZEN_FOR_STAGING_DRY_RUN_ONLY",
  "base_contract": "verified-historical-backfill-export-package@1.0.0",
  "compatibility": "MINOR_COMPATIBLE",
  "supersedes": "verified-historical-backfill-export-package@1.0.0",
  "frozen_base_semantics_unchanged": true,
  "required_fields": [
    "export_package_id",
    "revision",
    "contract_version",
