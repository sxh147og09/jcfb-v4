  "contract_version": "verified-historical-backfill-export-package@1.1.0",
  "source_origin": "CHATGPT_LIBRARY_EXPORT",
  "file_manifest_rule": "one entry per original file with filename, original SHA256, metadata snapshot SHA256, and Library identity",
