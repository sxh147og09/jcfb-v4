  "hash_boundary": {
    "package_substantive_hash_excludes": [
      "created_at",
      "exported_at",
      "package_substantive_hash",
      "package_sha256",
      "package_zip_sha256",
      "nested_manifest.export_package_hash",
      "nested_manifest.package_substantive_hash"
