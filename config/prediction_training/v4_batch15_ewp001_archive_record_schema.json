{
  "$id": "b15-ewp001-archive-record@1.0.0",
  "title": "JCFB V4 B15-EWP-001 Historical Source Archive Record",
  "contract_version": "historical-source-archive@1.0.0",
  "required_fields": [
    "archive_record_id",
    "acquisition_mode",
    "match_id",
    "match_identity",
    "cutoff_profile",
    "artifact_type",
    "source",
    "source_identity",
    "source_reference",
    "source_timestamp",
    "observed_at",
    "captured_at",
    "ingested_at",
    "availability_at",
    "source_availability_at",
    "original_payload_or_file_hash",
    "provenance",
    "provenance_hash",
    "revision",
    "supersedes",
    "capture_state",
    "eligibility_state",
    "payload",
    "artifact_hash"
  ],
  "capture_states": ["PENDING", "CAPTURED", "PARTIAL", "BLOCKED", "SUPERSEDED", "INVALID"],
  "eligibility_states": ["ELIGIBLE_FOR_AS_OF_TRAINING", "NOT_ELIGIBLE_FOR_AS_OF_TRAINING", "UNKNOWN", "BLOCKED"],
  "pre_match_artifact_types": ["canonical_match_facts", "official_odds_snapshot", "official_odds_screenshot", "external_market_snapshot", "team_context_source_artifact", "evidence_graph_ref", "statistical_feature_artifact_ref", "football_intelligence_ref", "market_intelligence_ref", "tactical_league_ref", "feature_bundle_ref", "batch14_gate_record_ref"],
  "post_match_artifact_types": ["final_result", "halftime_result", "outcome_label", "handicap_label_basis", "goals_label", "htft_label"],
  "time_rule": "availability_at <= prediction_cutoff_at < kickoff_at for pre-match records",
  "revision_rule": "new artifact and new hash with explicit supersedes; previous artifact retained",
  "original_artifact_rule": "official screenshot/file original is the provenance root and cannot be replaced by OCR/extraction",
  "storage_layout": {
    "pre_match": "pre_match/<match_id>/<cutoff_profile>/<artifact_type>/r###-<archive_record_id>.json",
    "post_match": "post_match/<match_id>/<cutoff_profile>/<artifact_type>/r###-<archive_record_id>.json",
    "manifest": "manifests/<archive_record_id>.json",
    "session": "manifests/sessions/<session_id>.json",
    "provenance": "provenance/<archive_record_id>/original<extension>"
  },
  "canonicalization": {
    "algorithm": "SHA-256",
    "profile": "v4-canonical-json@1.0",
    "encoding": "UTF-8",
    "key_order": "LEXICOGRAPHIC_RECURSIVE",
    "array_order": "PRESERVE_SEMANTIC_ORDER",
    "self_hash_field": "canonical_hash is omitted during hash computation"
  },
  "canonical_hash": "sha256:75003c7fbb154db3ab4476744e8ee19d18e1202e2624c909414c75ca398e31b7"
}
